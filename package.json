{
  "name": "heard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && node verify-i18n.mjs && node verify-tokens.mjs && node verify-router.mjs && node verify-contracts.mjs && node verify-pwa.mjs && node verify-sample.mjs && node scripts/verify-a4.mjs && vite build && node build-sw.mjs",
    "preview": "vite preview --host",
    "start": "vite --port 4173 --host",
    "test": "node --test --test-concurrency=1 tests/product-core.test.mjs",
    "verify:i18n": "node verify-i18n.mjs",
    "verify:tokens": "node verify-tokens.mjs",
    "verify:router": "node verify-router.mjs",
    "verify:contracts": "node verify-contracts.mjs",
    "verify:pwa": "node verify-pwa.mjs",
    "verify:sample": "node verify-sample.mjs",
    "verify:a4": "node scripts/verify-a4.mjs",
    "verify:engine": "node verify-engine.mjs",
    "make:sample": "node scripts/make-sample.mjs",
    "icons": "node make-icons.mjs",
    "verify:export": "node verify-export.mjs",
    "verify:export:golden": "node verify-export.mjs --golden",
    "verify:follow": "node verify-follow.mjs",
    "verify:core": "node --test --test-concurrency=1 tests/product-core.test.mjs",
    "verify:experience": "node verify-experience.mjs",
    "verify:touch": "node verify-touch.mjs",
    "verify:notes-retry": "node verify-notes-retry.mjs",
    "verify:intake": "node verify-intake.mjs",
    "verify:browser": "node verify-browser.mjs",
    "verify:all": "npm run build && npm run verify:core && npm run verify:export:golden && npm run verify:engine && npm run verify:browser"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.24.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
